---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { products, sections, site } from '../data/site';
import { languages, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// «12 €», «1,50 €»… con el formato de cada idioma
const price = (euros: number) =>
  new Intl.NumberFormat(languages[lang].htmlLang, {
    style: 'currency',
    currency: 'EUR',
    minimumFractionDigits: Number.isInteger(euros) ? 0 : 2,
  }).format(euros);
---

<section class="section shop" id={sections.shop} data-tone="bone">
  <div class="container">
    <header class="shop-head">
      <div>
        <p class="label" data-reveal>{t.shop.label}</p>
        <h2 class="display section-title" data-reveal style="--i:1">{t.shop.title}</h2>
      </div>
      <p class="lead" data-reveal style="--i:2">{t.shop.text}</p>
    </header>

    <ul class="products">
      {
        products.map((product, i) => (
          <li data-reveal style={`--i:${i}`}>
            <a
              class="product"
              href={site.instagram.dm}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${t.shop.products[product.id]}, ${price(product.price)}. ${t.shop.order} (${t.a11y.newTab})`}
            >
              <span class="product-tile" style={`--tile-bg:${product.tile}`}>
                <Image
                  src={product.image}
                  alt=""
                  widths={[320, 480, 720]}
                  sizes="(min-width: 62rem) 14vw, (min-width: 40rem) 24vw, 36vw"
                  loading="lazy"
                />
              </span>
              <span class="product-info">
                <span class="product-name">{t.shop.products[product.id]}</span>
                <span class="product-price">{price(product.price)}</span>
              </span>
              <span class="product-order">
                {t.shop.orderShort}
                <Icon name="external" size={14} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .shop-head {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.6fr);
    align-items: end;
    gap: 1.5rem clamp(2rem, 6vw, 6rem);
  }

  .products {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2rem) clamp(0.75rem, 1.6vw, 1.25rem);
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .product {
    display: block;
    transition: transform 160ms var(--ease-out);
  }

  .product:active {
    transform: scale(0.98);
  }

  .product-tile {
    position: relative;
    display: block;
    aspect-ratio: 1;
    border-radius: var(--radius);
    background: var(--tile-bg);
    overflow: hidden;
  }

  /* La ilustración cabe entera dentro del cuadro, con margen, sea vertical u horizontal */
  .product-tile img {
    position: absolute;
    inset: 11%;
    width: 78%;
    height: 78%;
    object-fit: contain;
    transition: transform 500ms var(--ease-out);
  }

  .product-info {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.9rem;
  }

  .product-name {
    font-weight: 700;
    line-height: 1.3;
  }

  .product-price {
    flex: none;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .product-order {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.2rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--fg-muted);
    transition: color 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .product:hover .product-tile img {
      transform: scale(1.05) rotate(-1.5deg);
    }

    .product:hover .product-order {
      color: var(--accent);
    }
  }

  @media (max-width: 62rem) {
    .shop-head {
      grid-template-columns: 1fr;
    }

    .products {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-tile img {
      transition: none;
    }
  }
</style>
