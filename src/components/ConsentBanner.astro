---
// Aviso de cookies. Está en todas las páginas: los vídeos de YouTube siempre
// piden permiso y, si hay Google Analytics configurado (`site.analyticsId`
// completo), también la analítica.
//
// Sigue el criterio de la AEPD: no se carga nada hasta que se acepta, y
// «Rebutja» y «Accepta» tienen el mismo tamaño y están al mismo nivel.
// «Configura» despliega un interruptor por tipo de cookie.
// La lógica está en src/scripts/consent.ts.
import { getRelativeLocaleUrl } from 'astro:i18n';
import { analyticsEnabled, site } from '../data/site';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { categories } = t.consent;

const options = [
  { id: 'necessary', ...categories.necessary, locked: true },
  ...(analyticsEnabled ? [{ id: 'analytics', ...categories.analytics, locked: false }] : []),
  { id: 'videos', ...categories.videos, locked: false },
];
---

<section
  class="consent"
  aria-label={t.consent.label}
  data-consent
  data-ga-id={analyticsEnabled ? site.analyticsId : undefined}
  hidden
>
  <p class="consent-text">
    {analyticsEnabled ? t.consent.text : t.consent.textVideos}{' '}
    <a href={`${getRelativeLocaleUrl(lang, 'legal/')}#galetes`}>{t.consent.more}</a>
  </p>

  <ul class="consent-options" id="consent-options" data-consent-options hidden>
    {
      options.map((option) => (
        <li>
          <label class="consent-option">
            <span class="consent-option-copy">
              <span class="consent-option-title">{option.title}</span>
              <span class="consent-option-text">{option.text}</span>
            </span>
            <input
              class="consent-switch"
              type="checkbox"
              role="switch"
              checked={option.locked}
              disabled={option.locked}
              data-consent-toggle={option.locked ? undefined : option.id}
            />
          </label>
        </li>
      ))
    }
  </ul>

  <div class="consent-actions">
    <button class="btn btn--sm consent-btn consent-btn--accept" type="button" data-consent-accept>
      {t.consent.accept}
    </button>
    <button class="btn btn--sm consent-btn" type="button" data-consent-reject>
      {t.consent.reject}
    </button>
    <button
      class="btn btn--sm consent-btn"
      type="button"
      aria-expanded="false"
      aria-controls="consent-options"
      data-consent-customize
    >
      {t.consent.customize}
    </button>
    <button class="btn btn--sm consent-btn" type="button" data-consent-save hidden>
      {t.consent.save}
    </button>
  </div>
</section>

<style>
  .consent {
    position: fixed;
    z-index: 150;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom));
    display: grid;
    gap: 1rem;
    width: min(100% - 1.5rem, 40rem);
    max-height: calc(100dvh - 2rem);
    overflow-y: auto;
    padding: 1.25rem;
    border-radius: var(--radius);
    background: var(--ink-3);
    color: var(--bone);
    box-shadow:
      inset 0 0 0 1px rgb(232 232 226 / 0.16),
      0 24px 48px -12px rgb(0 0 0 / 0.7);
    /* Oculto bajo el borde de la pantalla. Al cerrarse se va más rápido de lo que entra. */
    opacity: 0;
    transform: translate(-50%, calc(100% + 2rem));
    transition:
      transform 200ms var(--ease-out),
      opacity 200ms ease;
  }

  .consent[data-open] {
    opacity: 1;
    transform: translate(-50%, 0);
    transition:
      transform 500ms var(--ease-drawer),
      opacity 300ms ease;
  }

  .consent-text {
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .consent-text a {
    font-weight: 700;
    white-space: nowrap;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Opciones: aparecen con un fundido corto, sin empujar nada de golpe */
  .consent-options {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-block: 1px solid rgb(232 232 226 / 0.12);
    animation: consent-options-in 200ms var(--ease-out);
  }

  .consent-options li + li {
    border-top: 1px solid rgb(232 232 226 / 0.08);
  }

  .consent-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.8rem;
    cursor: pointer;
  }

  .consent-option:has(:disabled) {
    cursor: default;
  }

  .consent-option-copy {
    display: grid;
    gap: 0.15rem;
  }

  .consent-option-title {
    font-weight: 700;
  }

  .consent-option-text {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: rgb(232 232 226 / 0.68);
  }

  /* Interruptor: la bola se desliza; siempre se ve en qué estado está */
  .consent-switch {
    flex: none;
    position: relative;
    width: 2.75rem;
    height: 1.625rem;
    margin: 0;
    border-radius: 999px;
    background: rgb(232 232 226 / 0.22);
    appearance: none;
    cursor: inherit;
    transition: background-color 200ms ease;
  }

  .consent-switch::before {
    content: '';
    position: absolute;
    top: 0.1875rem;
    left: 0.1875rem;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--bone);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.35);
    transition: transform 200ms var(--ease-out);
  }

  .consent-switch:checked {
    background: var(--green);
  }

  .consent-switch:checked::before {
    transform: translateX(1.125rem);
  }

  .consent-switch:disabled {
    opacity: 0.55;
  }

  .consent-switch:focus-visible {
    outline: 2px solid var(--green-bright);
    outline-offset: 3px;
  }

  .consent-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 0.5rem;
  }

  /* Los botones, iguales en tamaño y peso: ninguno se esconde */
  .consent-btn {
    min-width: 6.5rem;
    background: var(--bone);
    color: var(--ink);
  }

  .consent-btn--accept {
    background: var(--green);
  }

  @media (hover: hover) and (pointer: fine) {
    .consent-btn:hover {
      background: #fff;
    }

    .consent-btn--accept:hover {
      background: var(--green-bright);
    }
  }

  @keyframes consent-options-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  @media (max-width: 40rem) {
    .consent {
      padding: 1.1rem;
    }

    .consent-actions {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .consent-btn {
      min-width: 0;
      min-height: 2.75rem;
      padding-inline: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .consent,
    .consent[data-open] {
      transform: translate(-50%, 0);
      transition: opacity 200ms ease;
    }

    .consent-options {
      animation: none;
    }

    .consent-switch::before {
      transition: none;
    }
  }

  @media print {
    .consent {
      display: none;
    }
  }
</style>
