---
// Aviso de cookies. Solo existe si hay Google Analytics configurado (un
// `site.analyticsId` completo): sin analítica no hay nada que consentir.
//
// Sigue el criterio de la AEPD: no se mide nada hasta que se acepta, y
// «Rebutja» y «Accepta» tienen el mismo tamaño y están al mismo nivel.
// La lógica está en src/scripts/analytics.ts.
import { getRelativeLocaleUrl } from 'astro:i18n';
import { analyticsEnabled, site } from '../data/site';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

{
  analyticsEnabled && (
    <section class="consent" aria-label={t.consent.label} data-consent data-ga-id={site.analyticsId} hidden>
      <p class="consent-text">
        {t.consent.text}{' '}
        <a href={`${getRelativeLocaleUrl(lang, 'legal/')}#galetes`}>{t.consent.more}</a>
      </p>
      <div class="consent-actions">
        <button class="btn btn--sm consent-btn" type="button" data-consent-reject>
          {t.consent.reject}
        </button>
        <button class="btn btn--sm consent-btn consent-btn--accept" type="button" data-consent-accept>
          {t.consent.accept}
        </button>
      </div>
    </section>
  )
}

<style>
  .consent {
    position: fixed;
    z-index: 150;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom));
    display: flex;
    align-items: center;
    gap: 1rem 1.5rem;
    width: min(100% - 1.5rem, 46rem);
    padding: 1rem 1rem 1rem 1.25rem;
    border-radius: var(--radius);
    background: var(--ink-3);
    color: var(--bone);
    box-shadow:
      inset 0 0 0 1px rgb(232 232 226 / 0.16),
      0 24px 48px -12px rgb(0 0 0 / 0.7);
    /* Oculto bajo el borde de la pantalla. Al cerrarse se va más rápido de lo que entra. */
    opacity: 0;
    transform: translate(-50%, calc(100% + 2rem));
    transition:
      transform 200ms var(--ease-out),
      opacity 200ms ease;
  }

  .consent[data-open] {
    opacity: 1;
    transform: translate(-50%, 0);
    transition:
      transform 500ms var(--ease-drawer),
      opacity 300ms ease;
  }

  .consent-text {
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .consent-text a {
    font-weight: 700;
    white-space: nowrap;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .consent-actions {
    display: flex;
    flex: none;
    gap: 0.5rem;
  }

  /* Los dos botones, iguales en tamaño y peso: ninguno se esconde */
  .consent-btn {
    min-width: 6.5rem;
    background: var(--bone);
    color: var(--ink);
  }

  .consent-btn--accept {
    background: var(--green);
  }

  @media (hover: hover) and (pointer: fine) {
    .consent-btn:hover {
      background: #fff;
    }

    .consent-btn--accept:hover {
      background: var(--green-bright);
    }
  }

  @media (max-width: 40rem) {
    .consent {
      flex-direction: column;
      align-items: stretch;
      padding: 1.1rem;
    }

    .consent-btn {
      flex: 1;
      min-height: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .consent,
    .consent[data-open] {
      transform: translate(-50%, 0);
      transition: opacity 200ms ease;
    }
  }

  @media print {
    .consent {
      display: none;
    }
  }
</style>
