---
import { Image } from 'astro:assets';
import ring from '../assets/brand/dragon-ring.webp';
import { sections, site } from '../data/site';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Los tres hitos: fundación, décimo aniversario y el año en curso
const years = [site.founded, site.founded + 10, new Date().getFullYear()];
---

<section class="section about" id={sections.about} data-tone="ink">
  <div class="container">
    <div class="about-grid">
      <div class="about-copy">
        <p class="label" data-reveal>{t.about.label}</p>
        <h2 class="display section-title" data-reveal style="--i:1">{t.about.title}</h2>
        <div class="about-body" data-reveal style="--i:2">
          {t.about.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>

      <div class="about-art" data-reveal style="--i:1">
        <div data-parallax="0.06">
          <Image
            src={ring}
            alt={t.about.logoAlt}
            widths={[320, 520, 800, 1000]}
            sizes="(min-width: 62rem) 30vw, 60vw"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <div class="history">
      <h3 class="sr-only">{t.about.timelineLabel}</h3>
      <ol class="timeline">
        {
          t.about.timeline.map((step, i) => (
            <li data-reveal style={`--i:${i}`}>
              <p class="timeline-year display">{years[i]}</p>
              <p class="timeline-title">{step.title}</p>
              <p class="timeline-text">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .about {
    padding-top: calc(var(--section-y) + 1rem);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .about-body {
    display: grid;
    gap: 1rem;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    max-width: 35rem;
    font-size: clamp(1.0625rem, 1.4vw, 1.1875rem);
    color: var(--fg-muted);
  }

  .about-body p:first-child {
    color: var(--fg);
  }

  /* Ancho explícito: reserva el hueco antes de que cargue la imagen */
  .about-art {
    width: min(100%, 24rem);
    justify-self: center;
  }

  .about-art img {
    width: 100%;
  }

  .timeline {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(3.5rem, 8vw, 6.5rem);
    border-top: 1px solid var(--rule);
  }

  .timeline li {
    position: relative;
    padding: 1.75rem 2rem 0 0;
  }

  .timeline li::before {
    content: '';
    position: absolute;
    top: -5px;
    left: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 5px var(--ink);
  }

  .timeline-year {
    font-size: clamp(2.75rem, 5.5vw, 4.5rem);
    color: var(--green);
    font-variant-numeric: tabular-nums;
  }

  .timeline-title {
    margin-top: 0.75rem;
    font-size: 1.125rem;
    font-weight: 700;
  }

  .timeline-text {
    margin-top: 0.35rem;
    max-width: 22rem;
    font-size: 0.9875rem;
    color: var(--fg-muted);
  }

  @media (max-width: 62rem) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-art {
      order: -1;
      width: 13rem;
      justify-self: start;
    }
  }

  @media (max-width: 44rem) {
    /* En móvil la línea del tiempo pasa a ser vertical */
    .timeline {
      grid-template-columns: 1fr;
      border-top: 0;
      border-left: 1px solid var(--rule);
    }

    .timeline li {
      padding: 0 0 2.25rem 1.5rem;
    }

    .timeline li:last-child {
      padding-bottom: 0;
    }

    .timeline li::before {
      top: 0.9rem;
      left: -5px;
    }
  }
</style>
