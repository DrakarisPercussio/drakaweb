---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { captionFor, mixedPhotos } from '../data/photos';
import { sections, site } from '../data/site';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Dos cintas de fotos pequeñas que se deslizan en sentidos opuestos.
// Las fotos se reparten alternándolas entre las dos. No llevan pie visible:
// el texto de cada una queda como descripción para lectores de pantalla.
const tiles = mixedPhotos.map((item) => ({ ...item, caption: captionFor(item, lang) }));
const rows = [tiles.filter((_, i) => i % 2 === 0), tiles.filter((_, i) => i % 2 === 1)];
---

<section class="section gallery" id={sections.gallery} data-tone="ink">
  <div class="container">
    <header class="gallery-head">
      <div>
        <p class="label" data-reveal>{t.gallery.label}</p>
        <h2 class="display section-title" data-reveal style="--i:1">{t.gallery.title}</h2>
      </div>
      <p data-reveal style="--i:2">
        <a
          class="link-arrow"
          href={site.instagram.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${t.gallery.cta} (${t.a11y.newTab})`}
        >
          {t.gallery.cta}
          <Icon name="external" size={16} />
        </a>
      </p>
    </header>
  </div>

  <div class="reel" data-reveal>
    {
      rows.map((row, r) => (
        <div class="reel-row" data-reel style={`--count:${row.length}`}>
          <div class:list={['reel-track', { reverse: r % 2 === 1 }]}>
            {/* Cada cinta lleva sus fotos dos veces: al acabar la primera tanda, la segunda ya ocupa su sitio */}
            {[0, 1].map((copy) => (
              <ul class="reel-group" aria-hidden={copy === 1 ? 'true' : undefined}>
                {row.map((tile) => (
                  <li class="reel-item">
                    <Image
                      src={tile.image}
                      alt={copy === 0 ? tile.caption : ''}
                      width={640}
                      widths={[320, 480, 640]}
                      sizes="(min-width: 62rem) 20rem, 14rem"
                      loading="lazy"
                    />
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .gallery {
    overflow: clip;
  }

  .gallery-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 2rem;
  }

  /* Las cintas van de borde a borde y se desvanecen en los extremos */
  .reel {
    --tile: clamp(13rem, 21vw, 19rem);
    --gap: clamp(0.5rem, 1vw, 0.875rem);
    display: grid;
    gap: var(--gap);
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
  }

  .reel-row {
    overflow: hidden;
  }

  .reel-track {
    display: flex;
    width: max-content;
    /* Movimiento constante: lineal. La duración crece con el número de fotos
       para que la velocidad sea la misma haya las que haya. */
    animation: reel calc(var(--count) * 9s) linear infinite;
    will-change: transform;
  }

  .reel-track.reverse {
    animation-direction: reverse;
  }

  .reel-group {
    display: flex;
    flex: none;
    gap: var(--gap);
    margin: 0;
    padding: 0 var(--gap) 0 0;
    list-style: none;
  }

  .reel-item {
    position: relative;
    flex: none;
    width: var(--tile);
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 0.875rem;
    background: var(--ink-2);
  }

  .reel-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Casi todo son fotos de grupo: se prioriza la franja de las caras */
    object-position: 50% 35%;
  }

  @keyframes reel {
    to {
      transform: translateX(-50%);
    }
  }

  /* Sin movimiento: las cintas se quedan quietas y se pueden recorrer a mano */
  @media (prefers-reduced-motion: reduce) {
    .reel {
      -webkit-mask-image: none;
      mask-image: none;
    }

    .reel-row {
      overflow-x: auto;
      padding-inline: var(--gutter);
    }

    .reel-track {
      animation: none;
    }

    .reel-group[aria-hidden='true'] {
      display: none;
    }
  }
</style>
