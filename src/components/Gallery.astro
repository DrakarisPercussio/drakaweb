---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import lona from '../assets/brand/lona.jpg';
import ring from '../assets/brand/dragon-ring.webp';
import poster from '../assets/brand/poster.webp';
import dragon10 from '../assets/brand/dragon-10.webp';
import dksClaw from '../assets/brand/dks-claw.webp';
import Icon from './Icon.astro';
import { sections, site } from '../data/site';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

interface Tile {
  src: ImageMetadata;
  fit: 'cover' | 'contain';
  bg?: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Cualquier foto que se deje en src/assets/gallery aparece aquí sola,
// ordenada por nombre de archivo.
const photoFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/gallery/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP}',
  { eager: true },
);
const photos: Tile[] = Object.keys(photoFiles)
  .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }))
  .map((path) => ({ src: photoFiles[path].default, fit: 'cover' }));

// Mientras no haya fotos, la galería enseña las ilustraciones de la colla.
const artwork: Tile[] = [
  { src: lona, fit: 'cover' },
  { src: ring, fit: 'contain', bg: '#131813' },
  { src: poster, fit: 'contain', bg: '#0c100c' },
  { src: dragon10, fit: 'contain', bg: '#6f7578' },
  { src: dksClaw, fit: 'contain', bg: '#000' },
];

const tiles = photos.length > 0 ? photos : artwork;
---

<section class="section gallery" id={sections.gallery} data-tone="ink">
  <div class="container">
    <header class="gallery-head">
      <div>
        <p class="label" data-reveal>{t.gallery.label}</p>
        <h2 class="display section-title" data-reveal style="--i:1">{t.gallery.title}</h2>
      </div>
      <p data-reveal style="--i:2">
        <a
          class="link-arrow"
          href={site.instagram.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${t.gallery.cta} (${t.a11y.newTab})`}
        >
          {t.gallery.cta}
          <Icon name="external" size={16} />
        </a>
      </p>
    </header>

    <ul class="grid">
      {
        tiles.map((tile, i) => (
          <li class="cell" data-reveal="clip" style={`--i:${i % 3}`}>
            <div class="tile" style={tile.bg ? `--tile-bg:${tile.bg}` : undefined}>
              <Image
                src={tile.src}
                alt={`${t.gallery.alt} ${i + 1}`}
                widths={[480, 800, 1200]}
                sizes="(min-width: 62rem) 46vw, (min-width: 40rem) 50vw, 92vw"
                loading="lazy"
                class:list={[tile.fit]}
              />
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .gallery-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 2rem;
  }

  /* Rejilla de 12 columnas con un ritmo que se repite cada cinco fotos:
     una grande y una mediana, luego tres iguales. */
  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: clamp(13rem, 27vw, 24rem);
    gap: clamp(0.5rem, 1.2vw, 1rem);
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .cell {
    grid-column: span 4;
  }

  .cell:nth-child(5n + 1) {
    grid-column: span 7;
  }

  .cell:nth-child(5n + 2) {
    grid-column: span 5;
  }

  .tile {
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--tile-bg, var(--ink-2));
  }

  .tile img {
    width: 100%;
    height: 100%;
    transition: transform 600ms var(--ease-out);
  }

  .tile .cover {
    object-fit: cover;
  }

  .tile .contain {
    object-fit: contain;
    padding: clamp(1rem, 2.5vw, 2rem);
  }

  @media (hover: hover) and (pointer: fine) {
    .tile:hover img {
      transform: scale(1.04);
    }
  }

  @media (max-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: clamp(9rem, 44vw, 15rem);
    }

    .cell,
    .cell:nth-child(5n + 2) {
      grid-column: span 1;
    }

    .cell:nth-child(5n + 1) {
      grid-column: span 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile img {
      transition: none;
    }
  }
</style>
