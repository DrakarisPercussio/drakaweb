---
// Crédito del fotógrafo, en la esquina de una foto grande: «Foto: Nom Cognom».
// Si la foto no tiene crédito (ver la lista en src/data/photos.ts), no pinta nada.
// El contenedor de la foto tiene que llevar `position: relative`.
import type { Credit } from '../data/photos';

interface Props {
  credits: Credit[];
  /** La palabra «Foto» en el idioma de la página */
  label: string;
  /** Arriba en vez de abajo, para fotos que ya llevan algo pegado en la esquina inferior */
  top?: boolean;
}

const { credits, label, top = false } = Astro.props;
---

{
  credits.length > 0 && (
    <p class:list={['photo-credit', { top }]}>
      {label}:{' '}
      {credits.map((credit, i) => (
        <Fragment>
          {i > 0 && ', '}
          {credit.url ? (
            <a href={credit.url} target="_blank" rel="noopener noreferrer">
              {credit.name}
            </a>
          ) : (
            credit.name
          )}
        </Fragment>
      ))}
    </p>
  )
}

<style>
  /* Una pastilla oscura translúcida: se lee igual sobre una foto clara que sobre una oscura */
  .photo-credit {
    position: absolute;
    z-index: 1;
    right: 0.6rem;
    bottom: 0.6rem;
    max-width: calc(100% - 1.2rem);
    padding: 0.25rem 0.65rem;
    /* Redondeado, pero no una cápsula: con varios nombres puede ocupar dos líneas */
    border-radius: 0.7rem;
    background: rgb(12 16 12 / 0.72);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: var(--bone);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.01em;
  }

  .photo-credit.top {
    top: 0.6rem;
    bottom: auto;
  }

  .photo-credit a {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
