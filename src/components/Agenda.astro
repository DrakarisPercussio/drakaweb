---
import Icon from './Icon.astro';
import { agenda, sections, site } from '../data/site';
import { languages, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const locale = languages[lang].htmlLang;

const format = (date: Date, options: Intl.DateTimeFormatOptions) =>
  new Intl.DateTimeFormat(locale, { timeZone: 'UTC', ...options }).format(date);

const gigs = [...agenda]
  .sort((a, b) => a.date.localeCompare(b.date))
  .map((gig) => {
    const date = new Date(`${gig.date}T00:00:00Z`);
    return {
      ...gig,
      day: format(date, { day: '2-digit' }),
      month: format(date, { month: 'short' }).replace('.', ''),
      year: date.getUTCFullYear(),
      weekday: format(date, { weekday: 'long' }),
    };
  });
---

<section class="section agenda" id={sections.agenda} data-tone="ink">
  <div class="container agenda-grid">
    <header class="agenda-head">
      <p class="label" data-reveal>{t.agenda.label}</p>
      <h2 class="display section-title" data-reveal style="--i:1">{t.agenda.title}</h2>
      <p class="agenda-follow" data-reveal style="--i:2">
        <a
          class="link-arrow"
          href={site.instagram.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${t.agenda.follow} (${t.a11y.newTab})`}
        >
          {t.agenda.follow}
          <Icon name="external" size={16} />
        </a>
      </p>
    </header>

    <div class="agenda-panel" data-reveal data-agenda>
      <ol class="gig-list">
        {
          gigs.map((gig) => (
            <li class="gig" data-date={gig.date}>
              <time class="gig-date" datetime={gig.time ? `${gig.date}T${gig.time}` : gig.date}>
                <span class="gig-day display">{gig.day}</span>
                <span class="gig-month">
                  {gig.month} {gig.year}
                </span>
              </time>
              <div class="gig-main">
                <h3 class="gig-title">{gig.title[lang]}</h3>
                <p class="gig-meta">
                  <span class="gig-weekday">{gig.weekday}</span>
                  {gig.place && ` · ${gig.place}`}
                </p>
              </div>
              {gig.time && <span class="gig-time">{gig.time}</span>}
            </li>
          ))
        }
      </ol>
      <p class="agenda-empty" data-agenda-empty hidden={gigs.length > 0}>{t.agenda.empty}</p>
    </div>
  </div>
</section>

<style>
  .agenda-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: start;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .agenda-head {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }

  .agenda-follow {
    margin-top: 2rem;
  }

  .agenda-panel {
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--rule);
    overflow: hidden;
  }

  .gig {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2rem);
    padding: clamp(0.9rem, 1.8vw, 1.25rem) clamp(1.1rem, 2.6vw, 2rem);
    transition: background-color 150ms ease;
  }

  /* Separador solo entre filas visibles (las fechas pasadas se ocultan) */
  .gig:not([hidden]) ~ .gig {
    border-top: 1px solid var(--rule);
  }

  .gig-date {
    display: grid;
    gap: 0.2rem;
  }

  .gig-day {
    font-size: clamp(2.5rem, 4.4vw, 3.5rem);
    line-height: 0.9;
    color: var(--green);
    font-variant-numeric: tabular-nums;
  }

  .gig-month {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--fg-muted);
  }

  .gig-title {
    font-size: clamp(1.0625rem, 1.6vw, 1.3125rem);
    font-weight: 700;
    line-height: 1.25;
  }

  .gig-meta {
    margin-top: 0.2rem;
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }

  .gig-weekday {
    text-transform: capitalize;
  }

  .gig-time {
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    box-shadow: inset 0 0 0 1px var(--rule);
  }

  .agenda-empty {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--fg-muted);
  }

  @media (hover: hover) and (pointer: fine) {
    .gig:hover {
      background-color: rgb(232 232 226 / 0.035);
    }
  }

  @media (max-width: 62rem) {
    .agenda-grid {
      grid-template-columns: 1fr;
    }

    .agenda-head {
      position: static;
    }
  }

  @media (max-width: 30rem) {
    .gig {
      grid-template-columns: 5rem minmax(0, 1fr);
    }

    .gig-time {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
