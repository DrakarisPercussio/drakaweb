---
// Página «Informació legal»: aviso legal, privacidad y cookies en una sola
// página con tres apartados. Los textos están en src/i18n/legal.ts y los datos
// de la entidad, en `site.legal` (src/data/site.ts).
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../layouts/Layout.astro';
import { analyticsEnabled, site } from '../data/site';
import { legalSections } from '../i18n/legal';
import { languages, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const longDate = (iso: string) =>
  new Intl.DateTimeFormat(languages[lang].htmlLang, { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(`${iso}T00:00:00Z`));

const sections = legalSections(lang, {
  name: site.legal.name,
  nif: site.legal.nif,
  registry: site.legal.registry,
  registryNumber: site.legal.registryNumber,
  registered: longDate(site.legal.registered),
  address: site.legal.address,
  email: site.email,
  instagram: site.instagram.handle,
  analytics: analyticsEnabled,
});

// En las listas, el arranque de cada punto («Titular:», «Analítica, només si
// l’acceptes.») va en negrita para poder leerlas en diagonal.
function leadIn(item: string): [string, string] {
  const cuts = [item.indexOf(': '), item.indexOf('. ')].filter((at) => at > 0 && at < 48);
  if (cuts.length === 0) return ['', item];
  const at = Math.min(...cuts) + 1;
  return [item.slice(0, at), item.slice(at)];
}
---

<Layout lang={lang} path="legal/" title={`${t.legal.title} · Drakaris Percussió`} description={t.legal.lead}>
  <div class="legal" data-tone="ink">
    <div class="container legal-wrap">
      <header class="legal-head" id="inici">
        <h1 class="display legal-title">{t.legal.title}</h1>
        <p class="lead">{t.legal.lead}</p>
        <nav class="legal-index" aria-label={t.legal.title}>
          <ul>
            {
              sections.map((section) => (
                <li>
                  <a href={`#${section.id}`}>{section.title}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <p class="legal-updated">
          {t.legal.updated}: <time datetime={site.legal.updated}>{longDate(site.legal.updated)}</time>
        </p>
      </header>

      {
        sections.map((section) => (
          <section class="legal-section" id={section.id}>
            <h2 class="display legal-heading">{section.title}</h2>
            {section.parts.map((part) => (
              <Fragment>
                {part.heading && <h3 class="legal-subheading">{part.heading}</h3>}
                {part.blocks.map((block) =>
                  Array.isArray(block) ? (
                    <ul class="legal-list">
                      {block.map((item) => {
                        const [lead, rest] = leadIn(item);
                        return (
                          <li>
                            {lead && <strong>{lead}</strong>}
                            {rest}
                          </li>
                        );
                      })}
                    </ul>
                  ) : (
                    <p>{block}</p>
                  ),
                )}
              </Fragment>
            ))}
          </section>
        ))
      }

      <p class="legal-back">
        <a class="btn btn--ghost" href={getRelativeLocaleUrl(lang)}>{t.legal.back}</a>
      </p>
    </div>
  </div>
</Layout>

<style>
  .legal {
    padding-top: calc(var(--header-h) + clamp(3rem, 8vw, 6rem));
    padding-bottom: var(--section-y);
  }

  /* Columna de lectura: unos 70 caracteres por línea */
  .legal-wrap {
    max-width: 46rem;
  }

  .legal-title {
    font-size: clamp(2.75rem, 8vw, 5rem);
  }

  .legal-head .lead {
    margin-top: 1.25rem;
    max-width: none;
  }

  .legal-index ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .legal-index a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 1rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 700;
    box-shadow: inset 0 0 0 1px var(--rule);
    transition:
      transform 160ms var(--ease-out),
      background-color 150ms ease,
      color 150ms ease;
  }

  .legal-index a:active {
    transform: scale(0.97);
  }

  .legal-updated {
    margin-top: 1.5rem;
    font-size: 0.875rem;
    color: var(--fg-muted);
  }

  .legal-section {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    padding-top: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--rule);
    /* Al llegar por un enlace, el título no queda debajo de la cabecera fija */
    scroll-margin-top: var(--header-h);
  }

  .legal-heading {
    font-size: clamp(1.875rem, 4.4vw, 2.75rem);
  }

  .legal-subheading {
    margin-top: 2.25rem;
    font-size: 1.125rem;
    font-weight: 700;
  }

  .legal-section p,
  .legal-list {
    margin-top: 0.9rem;
    color: #c3c9c2;
  }

  .legal-heading + p {
    margin-top: 1.5rem;
  }

  .legal-list {
    display: grid;
    gap: 0.75rem;
    padding-left: 1.1rem;
    list-style: disc;
  }

  .legal-list li::marker {
    color: var(--green);
  }

  .legal-list strong {
    color: var(--bone);
  }

  /* Direcciones y nombres técnicos largos no deben ensanchar la página en móvil */
  .legal-section {
    overflow-wrap: anywhere;
  }

  .legal-back {
    margin-top: clamp(3rem, 7vw, 4.5rem);
  }

  @media (hover: hover) and (pointer: fine) {
    .legal-index a:hover {
      background-color: var(--green);
      color: var(--ink);
    }
  }
</style>
