---
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import ring from '../assets/brand/LOGODKS.webp';
import Icon from './Icon.astro';
import LangSwitcher from './LangSwitcher.astro';
import { sections, site } from '../data/site';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Ruta de la página dentro de su idioma ('' = portada) */
  path?: string;
}

const { lang, path = '' } = Astro.props;
const t = useTranslations(lang);

// Desde la página legal, los enlaces a secciones llevan a la portada
const to = (id: string) => (path === '' ? `#${id}` : `${getRelativeLocaleUrl(lang)}#${id}`);

const legalUrl = getRelativeLocaleUrl(lang, 'legal/');
const legalLinks = [
  { id: 'avis-legal', label: t.legal.notice },
  { id: 'compres', label: t.legal.purchases },
  { id: 'privacitat', label: t.legal.privacy },
  { id: 'galetes', label: t.legal.cookies },
];
// Año en que se publica la web; el script de la página lo pone al día cada 1 de enero
const year = new Date().getFullYear();

// Las diseñadoras de los logos y los productos, «Nom A i Nom B» con la conjunción del idioma
const designers = new Intl.ListFormat(lang, { type: 'conjunction' }).formatToParts(site.designers.map((d) => d.name));

const links = [
  { id: sections.about, label: t.nav.about },
  { id: sections.history, label: t.nav.history },
  { id: sections.events, label: t.nav.events },
  { id: sections.agenda, label: t.nav.agenda },
  { id: sections.gallery, label: t.nav.gallery },
  { id: sections.shop, label: t.nav.shop },
  { id: sections.contact, label: t.nav.contact },
];
---

<footer class="footer" data-tone="ink">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <Image src={ring} alt="" width={112} height={130} loading="lazy" class="footer-mark" />
        <p class="footer-tagline">{t.footer.tagline}</p>
        {
          site.designers.length > 0 && (
            <p class="footer-credits">
              {t.footer.design}:{' '}
              {designers.map((part) => {
                const link = part.type === 'element' && site.designers.find((d) => d.name === part.value)?.url;
                return link ? (
                  <a href={link} target="_blank" rel="noopener noreferrer">
                    {part.value}
                  </a>
                ) : (
                  part.value
                );
              })}
            </p>
          )
        }
      </div>

      <nav class="footer-col" aria-label={t.footer.sections}>
        <h2 class="footer-heading">{t.footer.sections}</h2>
        <ul class="footer-links">
          {
            links.map((link) => (
              <li>
                <a href={to(link.id)}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer-col">
        <h2 class="footer-heading">{t.footer.social}</h2>
        <ul class="footer-links">
          {
            site.socials.map((social) => (
              <li>
                <a
                  class="footer-social"
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${social.label} (${t.a11y.newTab})`}
                  data-track="social_click"
                  data-track-detail={social.id}
                  data-track-place="footer"
                >
                  <Icon name={social.id} size={16} />
                  {social.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer-col">
        <h2 class="footer-heading">{t.a11y.language}</h2>
        <LangSwitcher lang={lang} label={t.a11y.language} path={path} />
      </div>
    </div>
  </div>

  <p class="footer-wordmark display" aria-hidden="true">Drakaris</p>

  <div class="container footer-bottom">
    <p>
      © <span data-current-year>{year}</span> Drakaris Percussió · {site.short} · {site.postcode}. {t.footer.rights}
    </p>
    <ul class="footer-legal">
      {
        legalLinks.map((link) => (
          <li>
            <a href={`${legalUrl}#${link.id}`}>{link.label}</a>
          </li>
        ))
      }
      {/* Lo muestra el script del aviso de cookies (sin JavaScript no serviría de nada) */}
      <li>
        <button type="button" data-consent-open hidden>
          {t.legal.cookieSettings}
        </button>
      </li>
    </ul>
    <a class="footer-top-link" href="#inici">
      {t.a11y.backTop}
      <Icon name="up" size={16} />
    </a>
  </div>
</footer>

<style>
  .footer {
    padding-top: clamp(4rem, 8vw, 6rem);
    overflow: clip;
  }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    gap: 2.5rem clamp(1.5rem, 4vw, 4rem);
  }

  .footer-mark {
    width: 3.5rem;
    height: auto;
  }

  .footer-tagline {
    margin-top: 1.25rem;
    max-width: 17rem;
    color: var(--fg-muted);
  }

  .footer-credits {
    margin-top: 0.75rem;
    max-width: 17rem;
    font-size: 0.875rem;
    color: var(--fg-muted);
  }

  .footer-credits a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    transition: color 150ms ease;
  }

  .footer-heading {
    margin-bottom: 1rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .footer-links {
    display: grid;
    gap: 0.15rem;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding-block: 0.3rem;
    font-weight: 600;
    transition: color 150ms ease;
  }

  /* Nombre gigante de lado a lado, solo en contorno. La caja mide menos que
     las letras (en Anton las mayúsculas ocupan de 0.05em a 0.92em con
     interlineado 1), así que quedan cortadas por la línea del pie. */
  .footer-wordmark {
    margin-top: clamp(3rem, 7vw, 5rem);
    height: 0.76em;
    font-size: 26.6vw;
    line-height: 1;
    letter-spacing: 0.01em;
    text-align: center;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px rgb(232 232 226 / 0.2);
    overflow: clip;
    user-select: none;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.5rem calc(1.5rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--rule);
    font-size: 0.875rem;
    color: var(--fg-muted);
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-right: auto;
  }

  .footer-legal a,
  .footer-legal button {
    display: inline-block;
    padding-block: 0.3rem;
    color: inherit;
    transition: color 150ms ease;
  }

  .footer-top-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    color: var(--fg);
    transition: color 150ms ease;
  }

  .footer-top-link :global(.icon) {
    transition: transform 200ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .footer-links a:hover,
    .footer-credits a:hover,
    .footer-legal a:hover,
    .footer-legal button:hover,
    .footer-top-link:hover {
      color: var(--green);
    }

    .footer-top-link:hover :global(.icon) {
      transform: translateY(-3px);
    }
  }

  @media (max-width: 62rem) {
    .footer-top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }
</style>
