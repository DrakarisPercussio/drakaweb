---
import { getRelativeLocaleUrl } from 'astro:i18n';
import '@fontsource/anton/latin-400.css';
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import antonWoff2 from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import '../styles/global.css';
import ConsentBanner from '../components/ConsentBanner.astro';
import Csp from '../components/Csp.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { agenda } from '../data/agenda';
import { analyticsEnabled, site } from '../data/site';
import { defaultLang, languages, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Ruta de la página dentro de su idioma: '' para la portada, 'legal/' para la página legal */
  path?: string;
  /** Título y descripción propios (si no, los de la portada) */
  title?: string;
  description?: string;
}

const { lang, path = '' } = Astro.props;
const t = useTranslations(lang);
const { title = t.meta.title, description = t.meta.description } = Astro.props;
const codes = Object.keys(languages) as Lang[];
const isHome = path === '';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const absolute = (url: string) => new URL(url, Astro.site).href;
const canonical = absolute(getRelativeLocaleUrl(lang, path));

// Datos estructurados: lo que Google lee para saber quién es Drakaris (nombre,
// otros nombres por los que se la busca, dónde está, redes) y qué actuaciones
// tiene por delante. Solo van en la portada.
const homeUrl = absolute(getRelativeLocaleUrl(defaultLang));
const today = new Date().toISOString().slice(0, 10);

const group = {
  '@type': 'MusicGroup',
  '@id': `${homeUrl}#drakaris`,
  name: 'Drakaris Percussió',
  legalName: site.legal.name,
  // Incluye la grafía con la que mucha gente lo escribe al buscar
  alternateName: ['Drakaris', site.short, 'Dracarys Percussió'],
  description: t.meta.description,
  url: homeUrl,
  logo: absolute(`${base}/icon-512.png`),
  image: absolute(`${base}/og.jpg`),
  foundingDate: String(site.founded),
  foundingLocation: { '@type': 'Place', name: `${site.city}, Barcelona` },
  address: {
    '@type': 'PostalAddress',
    streetAddress: "Carrer de l'Ateneu, 23-25",
    postalCode: site.postcode,
    addressLocality: site.city,
    addressRegion: 'Barcelona',
    addressCountry: 'ES',
  },
  ...(site.email && { email: site.email }),
  // Dónde se la puede contratar: ayuda a salir en búsquedas como «batucada Barcelona»
  areaServed: [
    { '@type': 'City', name: 'Sant Feliu de Llobregat' },
    { '@type': 'City', name: 'Barcelona' },
    { '@type': 'AdministrativeArea', name: 'Baix Llobregat' },
    { '@type': 'AdministrativeArea', name: 'Catalunya' },
  ],
  genre: ['Batucada', 'Percussió', 'Samba'],
  sameAs: site.socials.map((social) => social.url),
};

// Hora de España de cada fecha (+01:00 en invierno, +02:00 en verano), para
// que Google no tenga que adivinar la zona horaria de las actuaciones
const madridOffset = (date: string) => {
  const name = new Intl.DateTimeFormat('en-US', { timeZone: 'Europe/Madrid', timeZoneName: 'shortOffset' })
    .formatToParts(new Date(`${date}T12:00:00Z`))
    .find((part) => part.type === 'timeZoneName')?.value;
  const hours = Number(name?.replace('GMT', '') || 1);
  return `+${String(hours).padStart(2, '0')}:00`;
};

const upcoming = agenda
  .filter((gig) => gig.date >= today && gig.place)
  .map((gig) => {
    // «Carrer Joan Maragall, Sant Feliu de Llobregat» → calle y población
    const parts = gig.place!.split(',').map((part) => part.trim());
    const locality = parts.at(-1);
    return {
      '@type': 'Event',
      name: `${gig.title[lang]} · Drakaris Percussió`,
      description: t.agenda.eventDescription.replace('{title}', gig.title[lang]).replace('{place}', gig.place!),
      image: absolute(`${base}/og.jpg`),
      startDate: gig.time ? `${gig.date}T${gig.time}${madridOffset(gig.date)}` : gig.date,
      // La agenda no tiene hora de fin: el acto acaba el mismo día
      endDate: gig.time ? `${gig.date}T23:59${madridOffset(gig.date)}` : gig.date,
      // Sin `offers` a propósito: las actuaciones son casi siempre gratuitas y en
      // la calle, y Google solo lo pide para eventos con entrada
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: {
        '@type': 'Place',
        name: gig.place,
        address: {
          '@type': 'PostalAddress',
          ...(parts.length > 1 && { streetAddress: parts.slice(0, -1).join(', ') }),
          addressLocality: locality,
          addressRegion: 'Catalunya',
          addressCountry: 'ES',
        },
      },
      performer: { '@id': group['@id'] },
      organizer: { '@id': group['@id'] },
    };
  });

const structuredData = { '@context': 'https://schema.org', '@graph': [group, ...upcoming] };

// Dos scripts mínimos que tienen que ejecutarse antes de pintar la página, y por
// eso van escritos dentro de ella. Se definen aquí para poder autorizarlos por
// su huella en la política de seguridad (ver Csp.astro).

// Si venimos de cambiar de idioma, no se repiten las animaciones de entrada
const skipIntroScript = `try{if(sessionStorage.getItem('dk:lang-switch'))document.documentElement.classList.add('is-lang-switch')}catch(e){}`;

// Recupera el punto de la página en el que estabas al cambiar de idioma
const restoreScrollScript = `(function(){try{var raw=sessionStorage.getItem('dk:lang-switch');if(!raw)return;sessionStorage.removeItem('dk:lang-switch');var memory=JSON.parse(raw);var section=memory.id&&document.getElementById(memory.id);if(!section)return;var top=section.getBoundingClientRect().top+window.scrollY+memory.ratio*section.offsetHeight;window.scrollTo({top:top,behavior:'instant'})}catch(e){}})();`;
---

<!doctype html>
<html lang={languages[lang].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <Csp inlineScripts={[skipIntroScript, restoreScrollScript]} analytics={analyticsEnabled} />
    {/* Activa la transición entre páginas. Va aquí y no en el CSS: ver la nota en global.css */}
    <style is:inline>
      @view-transition {
        navigation: auto;
      }
    </style>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0c100c" />
    {/* La web ya tiene sus propios colores (fondo oscuro con secciones claras). Esto
         avisa al navegador para que no la «oscurezca» por su cuenta en los móviles con
         modo oscuro (Samsung Internet, Chrome…): se ve igual en todos los dispositivos. */}
    <meta name="color-scheme" content="only dark" />
    <meta name="generator" content={Astro.generator} />
    {site.searchConsoleVerification && <meta name="google-site-verification" content={site.searchConsoleVerification} />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {codes.map((code) => <link rel="alternate" hreflang={languages[code].htmlLang} href={absolute(getRelativeLocaleUrl(code, path))} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(getRelativeLocaleUrl(defaultLang, path))} />
    <link rel="sitemap" href={`${base}/sitemap.xml`} />

    {/* Icono: el .ico es el que buscan Google y los navegadores antiguos; el de
         192 px, el que usa Google en los resultados de búsqueda (pide 48 px o más) */}
    <link rel="icon" href={`${base}/favicon.ico`} sizes="48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}/icon-192.png`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="preload" as="font" type="font/woff2" href={antonWoff2} crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Drakaris Percussió" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absolute(`${base}/og.jpg`)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />

    {isHome && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}

    <script is:inline set:html={skipIntroScript} />
  </head>
  <body>
    <a class="skip-link" href="#contingut">{t.a11y.skip}</a>
    <ConsentBanner lang={lang} />
    <Header lang={lang} path={path} />
    <main id="contingut">
      <slot />
    </main>
    <Footer lang={lang} path={path} />

    <script is:inline set:html={restoreScrollScript} />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
