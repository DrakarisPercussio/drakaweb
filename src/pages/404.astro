---
// Página de error: GitHub Pages la enseña cuando alguien entra en una dirección
// que no existe (un enlace antiguo, una errata…). Como no se sabe en qué idioma
// venía la visita, el mensaje va en los tres.
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import '@fontsource/anton/latin-400.css';
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '../styles/global.css';
import ring from '../assets/brand/dragon-ring.webp';
import Csp from '../components/Csp.astro';
import { languages, useTranslations, type Lang } from '../i18n/ui';

const codes = Object.keys(languages) as Lang[];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="UTF-8" />
    <Csp />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0c100c" />
    <meta name="robots" content="noindex" />
    <title>404 · Drakaris Percussió</title>
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
  </head>
  <body data-tone="ink">
    <main class="lost">
      <Image src={ring} alt="" width={160} height={185} loading="eager" class="lost-mark" />
      <p class="lost-code display">404</p>
      <ul class="lost-list">
        {
          codes.map((code) => {
            const t = useTranslations(code);
            return (
              <li lang={languages[code].htmlLang}>
                <h1 class="lost-title">{t.notFound.title}</h1>
                <p class="lost-text">{t.notFound.text}</p>
                <a class="btn btn--primary btn--sm" href={getRelativeLocaleUrl(code)}>
                  {t.notFound.cta}
                </a>
              </li>
            );
          })
        }
      </ul>
    </main>
  </body>
</html>

<style>
  .lost {
    display: grid;
    justify-items: center;
    align-content: center;
    min-height: 100dvh;
    padding: clamp(2.5rem, 8vw, 5rem) var(--gutter);
    text-align: center;
  }

  .lost-mark {
    width: 5rem;
    height: auto;
  }

  .lost-code {
    margin-top: 1rem;
    font-size: clamp(6rem, 24vw, 13rem);
    line-height: 0.9;
    color: var(--green);
  }

  .lost-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem clamp(1.5rem, 4vw, 3rem);
    width: min(100%, 62rem);
    margin: clamp(2rem, 5vw, 3.5rem) 0 0;
    padding: clamp(2rem, 5vw, 3rem) 0 0;
    border-top: 1px solid var(--rule);
    list-style: none;
  }

  .lost-list li {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.5rem;
  }

  .lost-title {
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .lost-text {
    margin-bottom: 0.75rem;
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }

  @media (max-width: 44rem) {
    .lost-list {
      grid-template-columns: 1fr;
    }
  }
</style>
